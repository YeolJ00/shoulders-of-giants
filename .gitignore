__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.claude/

# Run outputs (regenerable). The run scripts in outputs/lsim/ are tracked: each holds its recipe and the
# prediction written before the run, and docs/DIRECTION.md cites them by path.
outputs/*
!outputs/lsim/
outputs/lsim/*
!outputs/lsim/*.sh

# Raw datasets, downloaded assets and generated datasets (large). data/real/ holds small files
# derived from real recordings and IS tracked.
data/phys101/
data/assets/
data/datasets/
data/render/
# Third-party downloads (untrusted; e.g. SimReady samples), never tracked.
data/external/

# Generated report pages embed media as base64 and are republished as artifacts; the written
# record is the .md files. The hand-written pages are the exception: the [SoG] main page and its leaves
# (published as artifacts; their videos in docs/media/ stay out of git) and the October design page.
docs/*.html
!docs/PROJECT_BRIEF.html
!docs/TEST_RESULTS.html
!docs/DATA.html
!docs/ARCHITECTURE.html
!docs/LEARNED_SIM.html

# Archived theta track: the same large or generated content, ignored at its archived paths.
archive/theta_track/outputs/
archive/theta_track/models/
archive/theta_track/assets/rigid/
archive/theta_track/assets/cloth/
archive/theta_track/assets/scenes/
archive/theta_track/assets/soft/
archive/theta_track/docs/*.html
archive/theta_track/docs/iters/
archive/theta_track/docs/videos/

# Raw downloads for the real-data audit (large); the derived numbers live in docs/results.
data/real/raw_*/

# Converted PGND windows (~2 GB; regenerated by scripts/l1_real_cloth_pgnd.py from data/real/raw_pgnd_cloth).
data/real/cloth/pgnd/
# Converted PhysTwin cloth recordings (5-17 MB each; regenerated by scripts/l1_real_cloth.py).
data/real/cloth/phystwin/*.npz
docs/media/
